pcs-rtl-otto: self-heal unsynced base-x lanes after link-up

phylink takes the link state of PHY-driven ports from the copper side,
so a 1000/2500base-x lane whose clause-37 handshake never completed (a
warm reboot reinitializes the lane while the attached PHY's SerDes
still runs the previous session) stays silently RX-dead: link up, zero
forwarding, cured only by a power cycle.  Check the lane sync state
shortly after every link-up; if the lane is unsynced, restart the lane
autoneg, then escalate to a full lane re-setup, then report.

===================================================================
--- a/pcs-rtl-otto.c
+++ b/pcs-rtl-otto.c
@@ -443,6 +443,8 @@
 	bool skip_rx_cali;	/* board quirk: skip the loopback RX-cal on this lane */
 	const u32 *fwnode_overrides;	/* <page reg mask value> quadruplets */
 	int n_fwnode_overrides;
+	struct delayed_work heal_work;	/* post-link-up lane sync check */
+	int heal_kicks;
 };
 
 struct rtpcs_ctrl {
@@ -4336,6 +4338,85 @@
 	}
 }
 
+/*
+ * Outband self-heal.  phylink takes the link state of PHY-driven ports from
+ * the copper side, so a 1000/2500base-x lane whose clause-37 handshake never
+ * completed (a warm reboot reinitializes the lane while the attached PHY's
+ * SerDes still runs the previous session) stays silently RX-dead: the port
+ * shows link, the lane never reaches sync, nothing forwards.  Verify the
+ * lane shortly after every link-up and kick it back into sync if needed:
+ * first by restarting the lane autoneg, then by re-running the full lane
+ * setup.
+ */
+#define RTPCS_HEAL_DELAY_MS	2000
+#define RTPCS_HEAL_MAX_KICKS	3
+
+static void rtpcs_sds_heal_work(struct work_struct *work)
+{
+	struct rtpcs_serdes *sds = container_of(to_delayed_work(work),
+						struct rtpcs_serdes, heal_work);
+	struct rtpcs_ctrl *ctrl = sds->ctrl;
+	int bmsr;
+
+	mutex_lock(&ctrl->lock);
+
+	/* the link-status bit latches low; read twice for the live state */
+	rtpcs_sds_read(sds, 0x02, MII_BMSR);
+	bmsr = rtpcs_sds_read(sds, 0x02, MII_BMSR);
+	if (bmsr < 0)
+		goto out;
+
+	if (bmsr & BMSR_LSTATUS) {
+		if (sds->heal_kicks)
+			dev_info(ctrl->dev, "SerDes %u lane synced after %d kick(s)\n",
+				 sds->id, sds->heal_kicks);
+		goto out;
+	}
+
+	if (sds->heal_kicks < 2) {
+		dev_warn(ctrl->dev,
+			 "SerDes %u link up but lane unsynced (BMSR 0x%04x), restarting lane AN\n",
+			 sds->id, bmsr);
+		sds->ops->restart_autoneg(sds);
+	} else if (sds->heal_kicks < RTPCS_HEAL_MAX_KICKS) {
+		dev_warn(ctrl->dev, "SerDes %u still unsynced, re-running lane setup\n",
+			 sds->id);
+		sds->ops->set_hw_mode(sds, sds->hw_mode, sds->usxgmii_submode);
+		sds->ops->activate(sds);
+		if (sds->ops->post_config)
+			sds->ops->post_config(sds, sds->hw_mode);
+		rtpcs_sds_apply_fwnode_overrides(sds);
+		sds->ops->restart_autoneg(sds);
+	} else {
+		dev_err(ctrl->dev,
+			"SerDes %u lane stuck unsynced (BMSR 0x%04x); a cold boot may be required\n",
+			sds->id, bmsr);
+		goto out;
+	}
+
+	sds->heal_kicks++;
+	mod_delayed_work(system_wq, &sds->heal_work,
+			 msecs_to_jiffies(RTPCS_HEAL_DELAY_MS));
+
+out:
+	mutex_unlock(&ctrl->lock);
+}
+
+static void rtpcs_pcs_link_up(struct phylink_pcs *pcs, unsigned int neg_mode,
+			      phy_interface_t interface, int speed, int duplex)
+{
+	struct rtpcs_link *link = rtpcs_phylink_pcs_to_link(pcs);
+	struct rtpcs_serdes *sds = link->sds;
+
+	if (sds->hw_mode != RTPCS_SDS_MODE_1000BASEX &&
+	    sds->hw_mode != RTPCS_SDS_MODE_2500BASEX)
+		return;
+
+	sds->heal_kicks = 0;
+	mod_delayed_work(system_wq, &sds->heal_work,
+			 msecs_to_jiffies(RTPCS_HEAL_DELAY_MS));
+}
+
 static int rtpcs_pcs_config(struct phylink_pcs *pcs, unsigned int neg_mode,
 			    phy_interface_t interface, const unsigned long *advertising,
 			    bool permit_pause_to_mac)
@@ -4465,6 +4546,14 @@
 	fwnode_handle_put(sds->fwnode);
 }
 
+static void rtpcs_cancel_heal_action(void *data)
+{
+	struct rtpcs_ctrl *ctrl = data;
+
+	for (int i = 0; i < ctrl->cfg->serdes_count; i++)
+		cancel_delayed_work_sync(&ctrl->serdes[i].heal_work);
+}
+
 static struct rtpcs_serdes *rtpcs_find_serdes(struct rtpcs_ctrl *ctrl,
 					      struct fwnode_handle *fwnode)
 {
@@ -4616,6 +4705,7 @@
 		sds->first_start = true;
 		sds->id = i;
 		sds->ops = ctrl->cfg->sds_ops;
+		INIT_DELAYED_WORK(&sds->heal_work, rtpcs_sds_heal_work);
 		for (int j = 0; j < RTPCS_MAX_LINKS_PER_SDS; j++)
 			sds->link_port[j] = -1;
 
@@ -4624,6 +4714,10 @@
 			return ret;
 	}
 
+	ret = devm_add_action_or_reset(dev, rtpcs_cancel_heal_action, ctrl);
+	if (ret)
+		return ret;
+
 	device_for_each_child_node_scoped(dev, child) {
 		ret = fwnode_property_read_u32(child, "reg", &sds_id);
 		if (ret)
@@ -4750,6 +4844,7 @@
 	.pcs_an_restart		= rtpcs_pcs_an_restart,
 	.pcs_config		= rtpcs_pcs_config,
 	.pcs_get_state		= rtpcs_pcs_get_state,
+	.pcs_link_up		= rtpcs_pcs_link_up,
 };
 
