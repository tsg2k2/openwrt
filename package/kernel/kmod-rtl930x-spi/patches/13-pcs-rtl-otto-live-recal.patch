Byte-faithful OEM 2500BASEX RX calibration for the SPI driver.

Earlier attempts (upstream do_rx_calibration, static register replay of the
post-usrApp delta, config+cal combos) did not revive the warm-flap RX-dead 2.5G
copper lanes.  A broad before/after-usrApp register diff showed the cure is a
dynamic training sequence, not a writable register set.  The upstream port's
step selection {1,2,4,5} diverges from the OEM cal core
(_dal_longan_sds_rxCali_a_startall = {1.1, 1.2, 1.3.1, 1.5}): it omits the DCVS
read-and-correct step (1.2.6) and the LEQ step (1.3.1), runs a Vth/tap step the
OEM does not, and has several different 1.1.x register values.

rtpcs_930x_sds_rxcali_2g5() transcribes the OEM a_startall faithfully (phy
param set: tap0=0x1f, vth_min=0x1), including the DCVS step.  recal_spi() runs
it on an already-up lane (live partner signal, no loopback/teardown), matching
how the OEM runs the cal post-link from its init pipeline + watchdog.
rtl930x_spi.c drives it from a debugfs trigger / post-link watchdog.

--- a/pcs-rtl-otto.c	2026-06-07 16:17:14.369288904 -0400
+++ b/pcs-rtl-otto.c	2026-06-07 23:43:06.381747192 -0400
@@ -4589,6 +4589,179 @@
 				       (enum rtpcs_sds_mode)hw_mode_int);
 }
 
+/*
+ * Byte-faithful OEM 2500BASEX RX calibration (RTL8221B copper, SDS5/6).
+ *
+ * Transcribed from the OEM SDK _dal_longan_sds_rxCali_a_startall() ->
+ * {1d1, 1d2(=rx_rst,1d2d1,1d2d2,1d2d3,1d2d6-DCVS,1d2d2), 1d3d1-LEQ, 1d5}
+ * with the phy_myParam set (tap0=0x1f, vth_min=0x1).  The upstream
+ * do_rx_calibration() omits the DCVS step (1d2d6) and the LEQ step (1d3.1),
+ * runs a Vth/tap step the OEM does not, and has several different 1.1.x
+ * register values -- and it does not revive the warm-flap RX-dead 2.5G lanes.
+ * This mirrors the OEM exactly.  Run on the live, already-up lane.
+ *
+ * hal_sds_field_write(u,s,pg,rg,hi,lo,v) -> rtpcs_sds_write_bits(sds,pg,rg,hi,lo,v)
+ * hal_serdes_reg_set(u,s,pg,rg,v)        -> rtpcs_sds_write(sds,pg,rg,v)
+ * hal_sds_field_read(...,&o)             -> o = rtpcs_sds_read_bits(...)
+ */
+static void rtpcs_930x_sds_2g5_1d1(struct rtpcs_serdes *sds)
+{
+	int tap0 = 0x1f, vth_min = 0x1;	/* phy_myParam */
+
+	rtpcs_sds_write(sds, 6, 0, 0);
+	/* 1.1.1 FGCAL/DCVS init */
+	rtpcs_sds_write_bits(sds, 0x2e, 0x1e, 15, 15, 1);	/* OEM-only */
+	rtpcs_sds_write_bits(sds, 0x2e, 0x01, 14, 14, 0);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x1c, 10, 5, 0x20);
+	rtpcs_sds_write_bits(sds, 0x2f, 0x02, 0, 0, 1);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x1e, 14, 11, 0);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x01, 15, 15, 0);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x02, 11, 11, 1);	/* OEM=1 (upstream 0) */
+	rtpcs_sds_write_bits(sds, 0x2e, 0x1c, 4, 0, 0);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x1d, 15, 11, 0);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x1d, 10, 6, 0);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x1d, 5, 1, 0);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x02, 10, 6, 0);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x11, 4, 0, 0);
+	rtpcs_sds_write_bits(sds, 0x2f, 0x00, 3, 0, 0xf);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x04, 6, 6, 1);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x04, 7, 7, 1);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x16, 14, 8, 0x20);	/* OEM=0x20 (upstream 0) */
+	rtpcs_sds_write_bits(sds, 0x2e, 0x03, 13, 8, 0xa);	/* OEM unconditional */
+	rtpcs_sds_write_bits(sds, 0x2e, 0x00, 13, 13, 0);	/* OEM unconditional */
+	rtpcs_sds_write_bits(sds, 0x2f, 0x03, 5, 0, tap0);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x09, 11, 6, 0);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x09, 5, 0, 0);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x0a, 5, 0, 0);
+	rtpcs_sds_write_bits(sds, 0x2f, 0x01, 5, 0, 0);
+	rtpcs_sds_write_bits(sds, 0x2f, 0x12, 5, 0, 0);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x0a, 11, 6, 0);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x06, 5, 0, 0);
+	rtpcs_sds_write_bits(sds, 0x2f, 0x01, 5, 0, 0);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x13, 5, 3, 7);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x13, 2, 0, 7);
+	rtpcs_sds_write_bits(sds, 0x2f, 0x0b, 5, 3, vth_min);
+	/* 1.1.2 load DFE init */
+	rtpcs_sds_write_bits(sds, 0x2e, 0x0f, 13, 7, 0x7f);
+	/* 1.1.3 disable LEQ training, enable DFE clock */
+	rtpcs_sds_write_bits(sds, 0x2e, 0x17, 7, 7, 0);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x17, 6, 2, 0);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x0c, 8, 8, 0);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x0b, 4, 4, 1);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x12, 14, 14, 0);
+	rtpcs_sds_write_bits(sds, 0x2f, 0x02, 15, 15, 0);
+	/* 1.1.4 offset cali setting */
+	rtpcs_sds_write_bits(sds, 0x2e, 0x0f, 15, 14, 3);
+	/* 1.1.5 LEQ/DFE (copper: skip the type==serdes/10G-media branch).  OEM
+	 * ends here -- it does NOT do upstream's 2e/19, 2f/0b[15:9], 2e/0b[1:0]. */
+	rtpcs_sds_write_bits(sds, 0x2e, 0x16, 3, 2, 2);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x0f, 6, 0, 0x5f);
+	rtpcs_sds_write_bits(sds, 0x2f, 0x05, 7, 2, 0x1f);
+}
+
+/* 1.2.2 SDS Rx reset */
+static void rtpcs_930x_sds_2g5_rxrst(struct rtpcs_serdes *sds)
+{
+	rtpcs_sds_write_bits(sds, 0x2e, 0x15, 8, 8, 0);
+	rtpcs_930x_sds_rx_reset(sds, RTPCS_SDS_MODE_2500BASEX);
+}
+
+/* 1.2.3 foreground offset cal read (binary,gray) */
+static void rtpcs_930x_sds_2g5_fgcal_read(struct rtpcs_serdes *sds, u32 *bin, u32 *gray)
+{
+	struct rtpcs_serdes *even = rtpcs_sds_get_even(sds);
+
+	rtpcs_sds_write(even, 0x1f, 0x2, (sds == even) ? 0x2f : 0x31);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x15, 9, 9, 1);
+	rtpcs_sds_write_bits(sds, 0x21, 0x06, 11, 6, 0x20);
+	rtpcs_sds_write_bits(sds, 0x2f, 0x0c, 5, 0, 0xf);
+	*gray = rtpcs_sds_read_bits(sds, 0x1f, 0x14, 5, 0);
+	rtpcs_sds_write_bits(sds, 0x2f, 0x0c, 5, 0, 0xe);
+	*bin = rtpcs_sds_read_bits(sds, 0x1f, 0x14, 5, 0);
+}
+
+/* 1.2.6 DCVS read (sign,coef) for read-index idx in {1,3} */
+static void rtpcs_930x_sds_2g5_dcvs_read(struct rtpcs_serdes *sds, int idx,
+					 u32 *sign, u32 *coef)
+{
+	struct rtpcs_serdes *even = rtpcs_sds_get_even(sds);
+
+	rtpcs_sds_write(even, 0x1f, 0x2, (sds == even) ? 0x2f : 0x31);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x15, 9, 9, 1);
+	rtpcs_sds_write_bits(sds, 0x21, 0x06, 11, 6, 0x20);
+	rtpcs_sds_write_bits(sds, 0x2f, 0x0c, 5, 0, (idx == 1) ? 0x23 : 0x25);
+	mdelay(1);
+	*sign = rtpcs_sds_read_bits(sds, 0x1f, 0x14, 4, 4);
+	*coef = rtpcs_sds_read_bits(sds, 0x1f, 0x14, 3, 0);
+}
+
+/* 1.2.6 DCVS manual apply for manual-index idx in {4,5} */
+static void rtpcs_930x_sds_2g5_dcvs_manual(struct rtpcs_serdes *sds, int idx,
+					   u32 sign, u32 coef)
+{
+	if (idx == 4) {
+		rtpcs_sds_write_bits(sds, 0x2e, 0x01, 15, 15, 1);
+		rtpcs_sds_write_bits(sds, 0x2e, 0x02, 10, 10, sign);
+		rtpcs_sds_write_bits(sds, 0x2e, 0x02, 9, 6, coef);
+	} else { /* idx == 5 */
+		rtpcs_sds_write_bits(sds, 0x2e, 0x02, 11, 11, 1);
+		rtpcs_sds_write_bits(sds, 0x2e, 0x11, 4, 4, sign);
+		rtpcs_sds_write_bits(sds, 0x2e, 0x11, 3, 0, coef);
+	}
+}
+
+void rtpcs_930x_sds_rxcali_2g5(struct rtpcs_serdes *sds)
+{
+	enum rtpcs_sds_mode m = RTPCS_SDS_MODE_2500BASEX;
+	u32 bin, gray, range, sign, coef;
+	int i;
+
+	/* 1.1 */
+	rtpcs_930x_sds_2g5_1d1(sds);
+	/* 1.2: rx reset, foreground offset cal */
+	rtpcs_930x_sds_rx_reset(sds, m);
+	rtpcs_sds_write_bits(sds, 0x2f, 0x02, 2, 2, 1);	/* 1d2d1 gray cfg */
+	rtpcs_sds_write_bits(sds, 0x2e, 0x01, 14, 14, 0);
+	rtpcs_930x_sds_2g5_rxrst(sds);			/* 1d2d2 */
+	for (i = 0; i < 10; i++) {			/* 1d2d3 foreground cal */
+		rtpcs_930x_sds_2g5_fgcal_read(sds, &bin, &gray);
+		range = rtpcs_sds_read_bits(sds, 0x2e, 0x15, 15, 14);
+		if (bin - 3U < 0x3a)
+			break;
+		if (range == 3)
+			break;
+		rtpcs_sds_write_bits(sds, 0x2e, 0x15, 15, 14, range + 1);
+		rtpcs_930x_sds_2g5_rxrst(sds);
+	}
+	/* 1d2d6 DCVS */
+	rtpcs_930x_sds_2g5_dcvs_read(sds, 1, &sign, &coef);
+	rtpcs_930x_sds_2g5_dcvs_manual(sds, 4, sign, coef);
+	rtpcs_930x_sds_2g5_dcvs_read(sds, 3, &sign, &coef);
+	rtpcs_930x_sds_2g5_dcvs_manual(sds, 5, sign, coef);
+	rtpcs_930x_sds_2g5_rxrst(sds);			/* trailing 1d2d2 */
+	/* 1.3.1 LEQ (type != serdes/0x14) */
+	rtpcs_sds_write_bits(sds, 0x2e, 0x0c, 8, 8, 0);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x17, 7, 7, 0);
+	rtpcs_sds_write_bits(sds, 0x2e, 0x18, 15, 15, 0);	/* LEQ_Manual(disable) */
+	mdelay(100);
+	/* 1.5 (copper: rx reset; media-gated tap1-4 skipped) */
+	rtpcs_930x_sds_rx_reset(sds, m);
+}
+
+int rtpcs_930x_sds_recal_spi(struct rtpcs_ctrl *ctrl, int sds_id, int hw_mode_int)
+{
+	enum rtpcs_sds_mode hw_mode = (enum rtpcs_sds_mode)hw_mode_int;
+
+	if (!ctrl || sds_id < 0 || sds_id >= RTPCS_SDS_CNT)
+		return -EINVAL;
+
+	if (hw_mode == RTPCS_SDS_MODE_2500BASEX)
+		rtpcs_930x_sds_rxcali_2g5(&ctrl->serdes[sds_id]);
+	else
+		rtpcs_930x_sds_do_rx_calibration(&ctrl->serdes[sds_id], hw_mode);
+	return 0;
+}
+
 static const struct of_device_id rtpcs_of_match[] = {
 	{
 		.compatible = "realtek,rtl8380-pcs",
