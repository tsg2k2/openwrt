#!/bin/sh
# Track wlan interface comings and goings in the wifi software
# flowtable: the kernel drops a netdev's ingress hook when the device
# unregisters, and a re-created interface does not rejoin on its own.

case "$ACTION" in
add)
	grep -qx 'DEVTYPE=wlan' "/sys/class/net/$INTERFACE/uevent" 2>/dev/null || exit 0
	;;
remove)
	nft list tables inet 2>/dev/null | grep -q wifi_sw_fastpath || exit 0
	;;
*)
	exit 0
	;;
esac

exec /usr/libexec/wifi-sw-fastpath.sh
