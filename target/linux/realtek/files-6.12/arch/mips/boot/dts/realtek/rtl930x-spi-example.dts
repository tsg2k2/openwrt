/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	compatible = "realtek,rtl930x-spi-demo";
	model = "RTL930x SPI Demo Board";

	aliases {
		ethernet0 = &ethernet;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x8000000>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		
		reset {
			label = "reset";
			gpios = <&gpio 11 GPIO_ACTIVE_LOW>;
			linux,code = <0x198>; /* KEY_RESTART */
		};
	};

	gpio-leds {
		compatible = "gpio-leds";
		
		power {
			label = "power";
			gpios = <&gpio 13 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};
		
		status {
			label = "status";
			gpios = <&gpio 14 GPIO_ACTIVE_LOW>;
		};
	};
};

&spi0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/* RTL930x switch connected via SPI */
	switch@0 {
		compatible = "realtek,rtl9300-spi";
		reg = <0>;
		spi-max-frequency = <10000000>;
		
		/* Hardware control GPIOs */
		reset-gpios = <&gpio 12 GPIO_ACTIVE_LOW>;
		cs-gpios = <&gpio 8 GPIO_ACTIVE_LOW>;
		
		/* Interrupt from switch to host */
		interrupt-parent = <&gpio>;
		interrupts = <15 IRQ_TYPE_LEVEL_LOW>;
		
		/* Switch port configuration */
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			
			/* LAN ports */
			port@0 {
				reg = <0>;
				label = "lan1";
				phy-handle = <&phy0>;
			};
			
			port@1 {
				reg = <1>;
				label = "lan2";
				phy-handle = <&phy1>;
			};
			
			port@2 {
				reg = <2>;
				label = "lan3";
				phy-handle = <&phy2>;
			};
			
			port@3 {
				reg = <3>;
				label = "lan4";
				phy-handle = <&phy3>;
			};
			
			/* WAN port */
			port@24 {
				reg = <24>;
				label = "wan";
				phy-handle = <&phy24>;
			};
			
			/* CPU port */
			port@28 {
				reg = <28>;
				label = "cpu";
				ethernet = <&ethernet>;
				phy-mode = "internal";
				
				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};
		
		/* MDIO bus for PHY management */
		mdio {
			compatible = "realtek,rtl930x-mdio";
			#address-cells = <1>;
			#size-cells = <0>;
			
			/* Internal PHYs */
			phy0: ethernet-phy@0 {
				reg = <0>;
				interrupt-parent = <&switch>;
				interrupts = <0>;
			};
			
			phy1: ethernet-phy@1 {
				reg = <1>;
				interrupt-parent = <&switch>;
				interrupts = <1>;
			};
			
			phy2: ethernet-phy@2 {
				reg = <2>;
				interrupt-parent = <&switch>;
				interrupts = <2>;
			};
			
			phy3: ethernet-phy@3 {
				reg = <3>;
				interrupt-parent = <&switch>;
				interrupts = <3>;
			};
			
			/* External PHY for WAN */
			phy24: ethernet-phy@24 {
				reg = <24>;
				interrupt-parent = <&switch>;
				interrupts = <24>;
			};
		};
		
		/* LED configuration */
		leds {
			compatible = "realtek,rtl930x-leds";
			
			/* LED set 0 configuration */
			led_set0 = <0x0040 0x0080 0x00C0 0x0100>;
			
			/* LED set 1 configuration */  
			led_set1 = <0x0140 0x0180 0x01C0 0x0200>;
			
			/* Force LED assignment for specific ports */
			realtek,led-set0-force-port-mask = <0x0000000F>; /* Ports 0-3 */
			realtek,led-set1-force-port-mask = <0x01000000>; /* Port 24 */
			
			active-low;
		};
	};
};

&ethernet {
	status = "okay";
	phy-mode = "internal";
	
	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&gpio {
	status = "okay";
};

&uart0 {
	status = "okay";
};